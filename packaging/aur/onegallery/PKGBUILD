# Maintainer: Your Name <you at example dot com>
#
# AUR package for tagged releases of One Gallery. To publish an update, run
# packaging/aur/publish.sh on Arch/Manjaro (it fills in sha256sums and .SRCINFO).
pkgname=onegallery
pkgver=0.3.0
pkgrel=1
pkgdesc="One UI style photo and video gallery for KDE Plasma"
arch=('any')
url="https://github.com/lochansaroy02/onegallery"
license=('MIT')
depends=('python' 'pyside6' 'python-pillow' 'python-cryptography' 'qt6-declarative' 'qt6-svg' 'qt6-imageformats'
         'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'ffmpeg')
optdepends=('python-watchdog: live updates when files change'
            'python-send2trash: move to trash (a built-in freedesktop trash is used otherwise)'
            'python-pillow-heif: HEIC/HEIF photos'
            'python-opencv: People (on-device face grouping)'
            'purpose: KDE share menu (KDE Connect, Bluetooth, e-mail, Imgur, ...)'
            'kdeconnect: import photos from your phone over Wi-Fi'
            'sshfs: import photos from your phone (KDE Connect "Browse device")'
            'plasma-integration: KDE global menu, native dialogs and theme'
            'dolphin: "Show in folder" selects the file'
            'xdg-utils: open files with other applications')
# the app used to be called LGallery
conflicts=('lgallery' 'lgallery-git')
replaces=('lgallery')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$pkgname-$pkgver"
    install -dm755 "$pkgdir/usr/share/onegallery"
    cp -r main.py backend qml "$pkgdir/usr/share/onegallery/"
    find "$pkgdir/usr/share/onegallery" -name '__pycache__' -prune -exec rm -rf {} +
    python -m compileall -q -o 0 -o 1 -s "$pkgdir" -p / "$pkgdir/usr/share/onegallery"

    install -Dm644 packaging/icon.svg "$pkgdir/usr/share/onegallery/packaging/icon.svg"
    install -Dm644 packaging/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/onegallery.svg"
    install -Dm644 packaging/onegallery.desktop "$pkgdir/usr/share/applications/onegallery.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

    install -dm755 "$pkgdir/usr/bin"
    printf '#!/bin/sh\nexec /usr/bin/python3 /usr/share/onegallery/main.py "$@"\n' > "$pkgdir/usr/bin/onegallery"
    chmod 755 "$pkgdir/usr/bin/onegallery"
}
